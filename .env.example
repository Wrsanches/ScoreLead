# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="ScoreLead <hello@scorelead.io>"
EMAIL_REPLY_TO=hello@scorelead.io
CONTACT_EMAIL=hello@scorelead.io

# Email (waitlist notifications)
NOTIFY_EMAIL=hello@scorelead.io

# Slack (account and plan-subscription alerts)
# Store this only as a server-side secret; never expose it with NEXT_PUBLIC_.
SLACK_WEBHOOK_URL=

# Google Analytics. Keep public acquisition and authenticated product traffic
# in separate GA4 properties/data streams. NEXT_PUBLIC_GA_ID remains a legacy
# fallback for the public site only.
NEXT_PUBLIC_GA_PUBLIC_ID=
NEXT_PUBLIC_GA_APP_ID=
NEXT_PUBLIC_GA_ID=

# Search indexing. Generate each value independently with:
# openssl rand -hex 16
INDEXNOW_KEY=
INDEXNOW_WEBHOOK_SECRET=
# Override only when running the IndexNow script against a non-production URL.
SCORELEAD_PUBLIC_URL=https://scorelead.io
# Public values are used by browser-side links and hostname routing.
NEXT_PUBLIC_SCORELEAD_PUBLIC_URL=https://scorelead.io
SCORELEAD_APP_URL=https://app.scorelead.io
NEXT_PUBLIC_SCORELEAD_APP_URL=https://app.scorelead.io

# Database (PostgreSQL) - openssl rand -base64 32
DATABASE_URL=

# Auth (better-auth)
BETTER_AUTH_SECRET=
# Use https://app.scorelead.io in Railway production.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Register both authorized redirect URIs in Google Cloud:
# http://localhost:3000/api/auth/callback/google
# https://app.scorelead.io/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firecrawl (lead enrichment)
FIRECRAWL_API_KEY=

# Google Maps Places API (lead discovery)
GOOGLE_PLACES_API_KEY=

# Brave Search API (lead enrichment)
BRAVE_SEARCH_API_KEY=

# OpenAI (lead AI extraction & summary, content calendar image generation)
OPENAI_API_KEY=
# Optional: override the GPT Image model (defaults to gpt-image-2.5-sunburst)
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Apollo.io (lead enrichment - email, LinkedIn, company data)
APOLLO_API_KEY=

# AWS S3 (image storage: business logos, avatars, content calendar, lead photos)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN / custom domain serving the bucket (no trailing slash).
# Leave blank to use the default https://<bucket>.s3.<region>.amazonaws.com URL.
AWS_S3_PUBLIC_BASE_URL=

# Stripe (tiered subscription billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard. See docs/stripe-setup.md.
# Starter - $19.95/mo, $199/yr, plus the one-time $2.95 paid-trial fee that is
# charged at checkout on the 7-day trial SKU.
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_STARTER_TRIAL_FEE_PRICE_ID=
# Growth - $29.95/mo, $299/yr
STRIPE_GROWTH_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
# Pro - $59.95/mo, $599/yr. Existing customers stay on the old $49 price; do
# not archive it in Stripe.
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Background job queue
# Max discovery jobs running at once across the app (default 3)
DISCOVERY_MAX_CONCURRENT=3
# Secret for the /api/jobs/pump cron endpoint (openssl rand -hex 16).
# Vercel Cron sends this automatically as a Bearer token.
CRON_SECRET=

# WhatsApp Business Platform (Meta Embedded Signup + Cloud API)
# Keep false until the integration is ready for customer activation.
NEXT_PUBLIC_WHATSAPP_INTEGRATION_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
# Pin to a Graph API version supported by your approved Meta app (for example v23.0).
META_GRAPH_API_VERSION=v23.0
# Random value configured identically in Meta's webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# 32-byte base64 or 64-character hex key: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Concurrent Cloud API sends claimed by each worker (default 3, max 10).
WHATSAPP_MAX_CONCURRENT=3

# Postgres pool size per instance (default 10)
DATABASE_POOL_MAX=10

# Instagram publishing (Instagram Login in the existing ScoreLead Meta app)
# Keep disabled until migrations, credentials and App Review are ready.
INSTAGRAM_INTEGRATION_ENABLED=false
# Optional comma-separated workspace IDs for testing before Meta approval.
INSTAGRAM_ALLOWED_BUSINESS_IDS=
# From Instagram > API setup with Instagram login. These differ from META_APP_ID/SECRET.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://app.scorelead.io/api/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v25.0
# Independent 32-byte key: openssl rand -base64 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Resend integration (customers connect their own Resend account)
# Production rollout flag; development and test are always on.
NEXT_PUBLIC_RESEND_INTEGRATION_ENABLED=false
# 32-byte key (hex or base64) for encrypting customer API keys and webhook secrets: openssl rand -base64 32
RESEND_TOKEN_ENCRYPTION_KEY=
# Optional public base URL for webhook endpoints (e.g. a tunnel in development). Defaults to SCORELEAD_APP_URL.
RESEND_WEBHOOK_PUBLIC_URL=
